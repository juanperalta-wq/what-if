  m_Name: 13_Desierto_Y_Camarones
  m_EditorClassIdentifier: Assembly-CSharp::StoryNode
  speakerName: "Hilari\xF3n Daza"
  dialogueText: "Noviembre de 1879. Tras el desembarco chileno en Pisagua, las tropas
    aliadas marchan exhaustas por el desierto de Atacama. Hilari\xF3n Daza debe avanzar
    desde el norte para unirse en Dolores con el ej\xE9rcito peruano donde combaten
    Belisario Su\xE1rez y Andr\xE9s Avelino C\xE1ceres."
  characterSprite: {fileID: -8038735614283676731, guid: 107e6ba09a5186e49ad7283980e65dc7, type: 3}
  backgroundSprite: {fileID: -5256418473622557830, guid: 9f70e7729722a7b45a0436024f8f03e8, type: 3}
  characterSide: 1
  flagSprites:
