  voiceAudio: {fileID: 8300000, guid: d31470f6962f6b447b80944b28bed783, type: 3}
  actNumber: 3
  actTitle: "La Campa\xF1a de Tarapac\xE1"
  isActStart: 1
  nextNodes:
  - {fileID: 11400000, guid: 9f90107f76f6dd34c8f6fdde8fd2b619, type: 2}
  - {fileID: 11400000, guid: a87ae89362e49384b8ddf8d1da4451f9, type: 2}
  - {fileID: 11400000, guid: f4d2cafdee8739a43871006e0db38850, type: 2}
  choiceTexts:
  - Cruzar la quebrada de Camarones durante la noche para evitar el calor y caer
    por la retaguardia chilena en Dolores.
  - "Dispersar las columnas en el desierto sin agua ni gu\xEDas buscando pozos aislados."
  - "Detener la marcha en Camarones y regresar hacia Arica, dejando aisladas a las
    fuerzas peruanas en Tarapac\xE1."
