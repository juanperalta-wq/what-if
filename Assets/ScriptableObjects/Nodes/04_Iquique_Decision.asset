  m_Script: {fileID: 11500000, guid: 944fe4cb866c73b46b3211fa6ec817f9, type: 3}
  m_Name: 04_Iquique_Decision
  m_EditorClassIdentifier: Assembly-CSharp::StoryNode
  speakerName: Miguel Grau
  dialogueText: "La Covadonga es de bajo calado, puede pasar por aguas poco profundas.
    Nuestra fragata pesa m\xE1s de 2000 toneladas, si Moore se acerca demasiado a
    la costa, encallar\xE1 y perderemos la mitad de nuestro poder naval. {PLAYER_NAME},
    conf\xEDo en su criterio t\xE1ctico. \xBFQu\xE9 hacemos?"
  characterSprite: {fileID: 0}
  backgroundSprite: {fileID: 0}
  nextNodes:
  - {fileID: 11400000, guid: 59c9038811f89bd4591a2da1a5645765, type: 2}
  - {fileID: 11400000, guid: f30209b7ecf84f144bd49a1de941cdc1, type: 2}
  choiceTexts:
  - "El Capit\xE1n Moore conoce su nave. Debemos confiar en su maniobra y terminar
    el rescate aqu\xED."
  - "\xA1Es una trampa de Condell! Dispare bengalas rojas y ordene a la Independencia
    abortar la persecuci\xF3n de inmediato."
