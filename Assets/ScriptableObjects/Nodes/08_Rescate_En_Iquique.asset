  m_Name: 08_Rescate_En_Iquique
  m_EditorClassIdentifier: Assembly-CSharp::StoryNode
  speakerName: Arturo Prat
  dialogueText: "Regresamos a la bah\xEDa de Iquique el 21 de mayo de 1879. Con el
    recuerdo del valeroso abordaje de Arturo Prat a\xFAn fresco en cubierta, Grau
    ordena rescatar a los n\xE1ufragos de la Esmeralda, mientras hacia el sur la
    fragata peruana Independencia persigue a la goleta Covadonga muy cerca de los
    arrecifes."
  characterSprite: {fileID: 979253466054647450, guid: 42f9159176ce7b04fac63af56e671d45, type: 3}
  backgroundSprite: {fileID: -326679476388971597, guid: 5367e201e42c74546b4b807e6813d23d, type: 3}
  characterSide: 1
  flagSprites:
