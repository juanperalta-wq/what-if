  m_Script: {fileID: 11500000, guid: 944fe4cb866c73b46b3211fa6ec817f9, type: 3}
  m_Name: 35_Final_Historico
  m_EditorClassIdentifier: Assembly-CSharp::StoryNode
  speakerName: Narrador
  dialogueText: "FINAL 3 \u2014 HIST\xD3RICO (MEMORIA Y RECONSTRUCCI\xD3N): Tras
    el Tratado de Anc\xF3n en octubre de 1883, el Per\xFA inicia una larga reconstrucci\xF3n
    nacional, logrando d\xE9cadas despu\xE9s la reincorporaci\xF3n de Tacna en 1929.
    El legado inmortal de Miguel Grau en Iquique, Francisco Bolognesi en Arica y
    Andr\xE9s Avelino C\xE1ceres en la resistencia queda grabado para siempre en
    la historia. (Fin de la partida)."
