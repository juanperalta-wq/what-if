  m_Name: 22_Sitio_Puerto_Arica
  m_EditorClassIdentifier: Assembly-CSharp::StoryNode
  speakerName: Francisco Bolognesi
  dialogueText: "Junio de 1880. Rodeado por mar y tierra en el puerto y bater\xEDas
    de Arica con apenas 1,800 defensores frente a m\xE1s de 5,300 atacantes, el coronel
    Francisco Bolognesi recibe el pedido oficial de rendici\xF3n."
  characterSprite: {fileID: 8659602654253924799, guid: 41f20a7fa0e58dc4da16d667fe2e7e78, type: 3}
  backgroundSprite: {fileID: -2652209381796279769, guid: be0f3401b50f37243aaf7d91014b8d7b, type: 3}
